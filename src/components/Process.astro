---
/**
 * The four-step process, ported from the original design.
 * An ordered list, so the sequence is conveyed to assistive technology too.
 */
const steps = [
  { title: 'Talk', body: 'Tell us about your business, your customers and what you want to change.' },
  { title: 'Plan', body: 'You get a clear plan, timeline and quote before any work starts.' },
  { title: 'Create', body: 'We design, build and shoot, and you see progress at every stage.' },
  { title: 'Launch and grow', body: 'We go live, then keep marketing, measuring and improving.' },
];
---

<div class="section-head">
  <h2>How a project runs</h2>
  <p>Four steps and one point of contact, from the first call to launch day.</p>
</div>

<ol class="steps">
  {
    steps.map((step, i) => (
      <li>
        <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
      </li>
    ))
  }
</ol>
