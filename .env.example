# Copy to .env and fill in before launch.

# Where the enquiry form posts. Any service that accepts a normal form POST
# works: FormSubmit, Formspree, Web3Forms, Netlify Forms, a Cloudflare Worker,
# your own handler. Must be PUBLIC_ prefixed — Astro only exposes those to the
# browser.
#
# Until this is set, the form validates and then shows the phone number and
# email address instead of pretending to send.
#
# Whichever provider you choose, name it in the "Who we share it with" section
# of src/pages/privacy.astro. It receives everything typed into the form.
PUBLIC_FORM_ENDPOINT=

# Optional. Some providers answer on a second URL for XHR submissions, which
# replies with JSON and the CORS headers a fetch needs, while the plain URL
# above redirects to their own thank-you page. Set both and each path gets the
# right one: the form element keeps posting to PUBLIC_FORM_ENDPOINT for visitors
# without JavaScript, and the script posts here. Leave empty if your provider
# has only one URL.
#
# FormSubmit, for example:
#   PUBLIC_FORM_ENDPOINT=https://formsubmit.co/you@example.com
#   PUBLIC_FORM_ENDPOINT_JS=https://formsubmit.co/ajax/you@example.com
PUBLIC_FORM_ENDPOINT_JS=
