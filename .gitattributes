# Normalise line endings so the repo stays consistent across Windows and CI.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.woff2 binary

# Pre-bundled Three.js and the original single-file build: generated/archived,
# so keep them out of diffs and language statistics.
public/q3d.js linguist-generated=true -diff
reference/* linguist-vendored=true -diff
